# Docker Compose environment variables for infra/docker-compose.yml
# Copy this file to infra/.env on the deployment server and fill in real credentials.

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Maps JavaScript API browser key (basemap). Leave empty to use OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# roadmap | satellite | hybrid | terrain
GOOGLE_MAPS_TYPE=roadmap
