APP_NAME=PedestriRoute
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL + PostGIS in Docker)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pedestriroute
DB_USERNAME=pedestriroute
DB_PASSWORD=secretpassword

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pedestriroute.test"
MAIL_FROM_NAME="${APP_NAME}"

# PedestriRoute Configurations (SRS v1.2)
CFG_CV_ENABLED=false
CFG_CV_THRESHOLD=0.80
CFG_PHOTO_MAX_MB=5
CFG_SNAP_RADIUS_M=50
CFG_REPORTS_SATURATION=3
CFG_LEVEL_GOOD=70
CFG_LEVEL_WARN=40
CFG_MAX_LOGIN_ATTEMPTS=5
CFG_LOCKOUT_MINUTES=15
CFG_TOKEN_TTL_HOURS=12
CFG_SERVICE_AREA_MIN_LAT=-7.40
CFG_SERVICE_AREA_MAX_LAT=-7.12
CFG_SERVICE_AREA_MIN_LON=112.55
CFG_SERVICE_AREA_MAX_LON=112.90

ADMIN_DEFAULT_NAME="Administrator PedestriRoute"
ADMIN_DEFAULT_EMAIL="admin@pedestriroute.test"
ADMIN_DEFAULT_PASSWORD="adminpassword123"

# Google OAuth Config
# Set GOOGLE_OAUTH_MOCK=false and add your client credentials from Google Cloud Console if testing real Google Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_MOCK=true

# Facebook OAuth Config
# Set FACEBOOK_OAUTH_MOCK=false and add your client credentials from Meta for Developers if testing real Facebook Login
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/facebook/callback
FACEBOOK_OAUTH_MOCK=true

VITE_APP_NAME="${APP_NAME}"
